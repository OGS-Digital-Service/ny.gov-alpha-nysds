<script>
    document.addEventListener('DOMContentLoaded', () => {
    // Get all submit buttons within nys-textinput elements
    const submitButtons = document.querySelectorAll('nys-textinput nys-button[type="submit"]');

    // Add event listeners to each submit button
    submitButtons.forEach(button => {
        button.addEventListener('click', () => {
            // Get the closest nys-textinput element
            const inputElement = button.closest('nys-textinput');

            // Check if the input value is empty
            if (inputElement.value.trim() === '') {
                // Add showError attribute
                inputElement.setAttribute('showError', '');
            } else {
                // Remove showError attribute
                inputElement.removeAttribute('showError');
            }
        });
    });
});
</script>