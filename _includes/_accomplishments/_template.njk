<section class="flex flex-col items-center max-w-[1160px] mx-auto mt-[80px] p-6 lg:p-0">


    <h2 class="text-[28px] text-center mb-[38px] mx-4"> {{params.title}}</h2>

    <div class="flex flex-wrap xl:flex-nowrap w-full 
                justify-center xl:justify-between
                gap-6 xl:gap-0
                px-8 xl:px-0
                
                ">
        {% for tile in params.tiles %}
        <a  href="{{tile.link}}" 
            class="flex flex-col no-underline group border border-solid border-neutral-200  
            hover:border-transparent focus:border-transparent 
            focus:outline focus:outline-2 focus:outline-theme hover:outline hover:outline-2 hover:outline-neutral-900 
            rounded-lg p-8 
            w-3/4 sm:w-[360px]
            "

            aria-labelledby="tile-heading-{{loop.index}}"
            aria-describedby="tile-description-{{loop.index}}"
        >
            <div class="{{tile.icon}} text-[40px] text-theme-mid group-hover:text-theme group-focus:text-theme" aria-hidden="true"></div>
            <h3 class="text-theme text-[20px] group-focus-within:underline group-hover:underline" 
                id="tile-heading-{{loop.index}}"
                >
                {{tile.title}} 
            </h3>
            <p class="text-black text-[18px] leading-6 mt-0"
                id="tile-description-{{loop.index}}"
                >
                {{tile.text}}
            </p>
            <div class="fa-solid fa-arrow-right text-theme-mid text-[20px] mt-auto group-hover:text-theme group-focus:text-theme" aria-hidden="true"></div>
        </a>
        {% endfor %}
    </div>



</section>