<section class="flex bg-[url('/img/{{params.image}}')] bg-no-repeat bg-cover bg-center" >
    {# <img src="/img/{{params.image}}" class="absolute " alt=""/> #}
    {# <div class="" style="background-image: url(/img/{{params.image}})"></div> #}

    <div class="flex flex-col w-1/4 border border-solid border-neutral-200 rounded-lg p-8 bg-white m-16">
        <div class=""><img src="/img/{{params.icon}}" class="w-24" alt="I love NY logo"/></div>

        <h2 class="text-[20px]">{{params.title}}</h2>

        <p class="text-black leading-md mt-0">{{params.description}}</p>

        <div class="flex flex-col">
            {% for link in params.links %}
            <a href="{{link.url}}" class="flex group text-link no-underline w-fit mb-2">
                <span class="group-hover:underline group-focus:underline">{{link.text}} </span>
                <span class="fa-solid fa-up-right-from-square text-link text-[12px] ml-2 mt-0.5 group-hover:no-underline group-focus:no-underline" aria-hidden="true"></span>
                </a>
            {% endfor %}
        </div>
    </div>




</section>